{
  "manifest_version": 3,
  "name": "Claude Code Local Browser Bridge",
  "version": "1.0.0",
  "description": "Connects the local Claude Code CLI to Chrome through Native Messaging.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "tabs", "scripting", "windows"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude Code Browser Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
