    "upstreamCommit": "cef0bfc390393f716903e16d50408118047f87e0"
  },
  "apiVersion": "^1.0.0",
  "description": "Local multi-account WeChat channel integration with isolated routing, replies, media, diagnostics, and permission relay.",
