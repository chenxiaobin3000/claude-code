{
  "name": "@claude-code-best/weixin-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:smoke": "bun run ../../scripts/validation/workspace-smoke.ts"
  },
  "workspaceValidation": {
    "build": {
      "applicable": false,
      "reason": "The root build:weixin-host script compiles this local Plugin into a standalone distribution."
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  }
}
