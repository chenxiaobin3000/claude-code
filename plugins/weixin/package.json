{
  "name": "@claude-code/weixin-plugin",
  "version": "1.1.0",
  "weixinCompatibility": {
    "upstreamPackage": "@tencent-weixin/openclaw-weixin",
    "upstreamVersion": "2.4.6",
    "upstreamCommit": "cef0bfc390393f716903e16d50408118047f87e0",
    "upstreamRepository": "https://github.com/Tencent/openclaw-weixin",
    "auditedAt": "2026-08-03"
  },
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:smoke": "bun run ../../scripts/validation/workspace-smoke.ts"
  },
  "workspaceValidation": {
    "build": {
      "applicable": false,
      "reason": "The root build:weixin-host script compiles this local Plugin into a standalone distribution."
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  }
}
