{
  "name": "@claude-code/openai-proxy-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:smoke": "bun run ../../scripts/validation/workspace-smoke.ts"
  },
  "workspaceValidation": {
    "build": {
      "applicable": false,
      "reason": "The root build:openai-proxy-host script compiles this local Plugin into a standalone distribution."
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
