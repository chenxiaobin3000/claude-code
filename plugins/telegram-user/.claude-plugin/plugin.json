{
  "name": "telegram-user",
  "version": "1.0.0",
  "telegramUserCompatibility": {
    "gramjs": "2.26.22",
    "gramjsCommit": "3aedb2e6ef216d307607f3d0f3f5b0ace6701378"
  },
  "apiVersion": "^1.0.0",
  "description": "On-demand Telegram user account history access over GramJS MTProto.",
  "author": { "name": "claude-code" },
  "keywords": ["telegram", "user", "mtproto", "gramjs", "history", "local"],
  "mcpServers": {
    "telegram-user-control": {
      "type": "stdio",
      "command": "bun",
      "args": ["${CLAUDE_PLUGIN_ROOT}/host/entry.ts", "control-mcp"]
    }
  }
}
