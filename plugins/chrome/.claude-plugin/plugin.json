{
  "name": "chrome",
  "version": "0.1.0",
  "apiVersion": "^1.0.0",
  "description": "Local-only Chrome integration through a standard Plugin MCP server, Skill, Native Host, and Chrome extension.",
  "author": {
    "name": "claude-code"
  },
  "keywords": ["chrome", "browser", "native-messaging", "local"],
  "mcpServers": {
    "claude-in-chrome": {
      "type": "stdio",
      "command": "bun",
      "args": ["${CLAUDE_PLUGIN_ROOT}/host/entry.ts", "mcp"]
    },
    "chrome-dom": {
      "type": "stdio",
      "command": "bun",
      "args": ["${CLAUDE_PLUGIN_ROOT}/host/entry.ts", "dom-mcp"]
    }
  }
}
